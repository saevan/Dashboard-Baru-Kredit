# --- Dev & QA ---
tests/
node_modules/
.github/

# --- Data uji mesin (bukan runtime) ---
data/demo/backtest-*.json
data/demo/09_ACUAN_WAWANCARA.csv

# --- Dokumen internal ---
docs/

# --- Metadata repo & editor ---
.git/
.gitignore
.vscode/
.idea/
